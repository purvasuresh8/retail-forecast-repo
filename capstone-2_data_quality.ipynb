# =========================
# Part 1 — Setup
# =========================
import os
import re
import numpy as np
import pandas as pd
from datetime import datetime, timedelta
from IPython.display import display

try:
    from google.colab import drive
except Exception:
    drive = None

# =========================
# Part 2 — Mount Google Drive
# =========================
mount_drive = True

if mount_drive and drive is not None:
    drive.mount('/content/drive', force_remount=False)
    DRIVE_BASE = '/content/drive/MyDrive'
else:
    DRIVE_BASE = '/content'

os.makedirs(DRIVE_BASE, exist_ok=True)
print("Save folder:", DRIVE_BASE)

# =========================
# Part 3 — Load raw dataset
# =========================
raw_path = os.path.join(DRIVE_BASE, "raw_sales.csv")
df = pd.read_csv(raw_path, encoding="latin1", low_memory=False)
print("Loaded shape:", df.shape)
display(df.head())

# =========================
# Part 4 — Standardize column names
# =========================
df.columns = df.columns.str.strip().str.lower().str.replace(" ", "_")
print("Columns:", df.columns.tolist())

# =========================
# Part 5 — Constraint-based Cleaning Rules
# =========================

# Convert date columns
date_cols = [c for c in df.columns if "date" in c]
for d in date_cols:
    df[d] = pd.to_datetime(df[d], errors="coerce")

# Drop rows where any critical NOT NULL fields are missing
critical_fields = [
    "firstname", "lastname", "email", "productcode",
    "price", "transactionamount", "transactiondate"
]
missing_before = len(df)
df = df.dropna(subset=[c for c in critical_fields if c in df.columns])
print(f"Dropped {missing_before - len(df)} rows missing critical fields (NOT NULL enforcement).")

# Drop rows with invalid numeric constraints
if "price" in df.columns:
    before = len(df)
    df = df[df["price"] >= 0]
    print(f"Dropped {before - len(df)} rows with negative Price values.")

if "discount" in df.columns:
    before = len(df)
    df = df[(df["discount"] >= 0) & (df["discount"] <= 100)]
    print(f"Dropped {before - len(df)} rows with invalid Discount values.")

# Drop future or too-old transaction dates
if "transactiondate" in df.columns:
    now = pd.Timestamp.now()
    cutoff_20y = now - pd.DateOffset(years=20)
    before = len(df)
    df = df[(df["transactiondate"] <= now) & (df["transactiondate"] >= cutoff_20y)]
    print(f"Dropped {before - len(df)} rows with invalid transaction dates (future/too old).")

# Clean and validate email format
if "email" in df.columns:
    email_pattern = re.compile(r"^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$")
    df["email"] = df["email"].astype(str).str.strip().str.lower()
    before = len(df)
    df = df[df["email"].apply(lambda x: bool(email_pattern.match(x)))]
    print(f"Dropped {before - len(df)} rows with invalid email format.")

# Clean phone numbers
if "phonenumber" in df.columns:
    # Keep only digits, remove punctuation/spaces
    df["phonenumber"] = df["phonenumber"].astype(str).str.replace(r"\D", "", regex=True)
    # Truncate to 15 digits (sane upper limit)
    df["phonenumber"] = df["phonenumber"].str[:15]
    # Replace empty strings with "Unknown"
    df["phonenumber"] = df["phonenumber"].replace("", "Unknown")

# Fill missing categorical text fields
text_fill = ["gender", "maritalstatus", "city", "state"]
for c in text_fill:
    if c in df.columns:
        df[c] = df[c].fillna("Unknown")

# Drop duplicates
df = df.drop_duplicates()

# =========================
# Part 6 — Validate after cleaning
# =========================
print("\n After cleaning:")
display(df.describe(include='all'))
print("Shape after cleaning:", df.shape)

for c in critical_fields:
    if c in df.columns:
        assert df[c].isna().sum() == 0, f"Column {c} still has nulls!"

# =========================
# Part 7 — Save clean dataset
# =========================
clean_path = os.path.join(DRIVE_BASE, "clean_sales.csv")
df.to_csv(clean_path, index=False)
print("Saved cleaned dataset to:", clean_path)

# =========================
# Part 8 — DQ Report
# =========================
dq_summary = {
    "rows_final": len(df),
    "dropped_nulls": missing_before - len(df),
    "valid_price_rows": (df["price"] >= 0).sum() if "price" in df.columns else None,
    "valid_discount_rows": ((df["discount"] >= 0) & (df["discount"] <= 100)).sum() if "discount" in df.columns else None,
}
dq_summary_path = os.path.join(DRIVE_BASE, "dq_summary.csv")
pd.DataFrame([dq_summary]).to_csv(dq_summary_path, index=False)
print("Saved DQ summary to:", dq_summary_path)

# =========================
# Part 9 — Completion message
# =========================
print("\nNotebook 2 complete  — 'clean_sales.csv' is ready for Supabase import (retail.clean_sales).")
print("All rows now meet your SQL constraints and email/phone formats are normalized.")
