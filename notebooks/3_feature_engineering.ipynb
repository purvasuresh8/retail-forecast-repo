# =========================
# Part 1 — Setup
# =========================
import os
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from IPython.display import display

try:
    from google.colab import drive
except Exception:
    drive = None

sns.set(style="whitegrid")

# =========================
# Part 2 — Mount Google Drive
# =========================
mount_drive = True

if mount_drive and drive is not None:
    drive.mount('/content/drive', force_remount=False)
    DRIVE_BASE = '/content/drive/MyDrive'
else:
    DRIVE_BASE = '/content'

os.makedirs(DRIVE_BASE, exist_ok=True)
print("Save folder:", DRIVE_BASE)

# =========================
# Part 3 — Load clean dataset
# =========================
clean_path = os.path.join(DRIVE_BASE, "clean_sales.csv")
df = pd.read_csv(clean_path, parse_dates=["transactiondate"], low_memory=False)

print("Loaded shape:", df.shape)
display(df.head())

# =========================
# Part 4 — Basic dataset info
# =========================
print("Columns:", df.columns.tolist())
display(df.describe(include='all'))

print("\nMissing values check:")
display(df.isna().sum())

# =========================
# Part 5 — Feature Engineering
# =========================

# 1. Transaction year and month
if "transactiondate" in df.columns:
    df["transaction_year"] = df["transactiondate"].dt.year
    df["transaction_month"] = df["transactiondate"].dt.month
    df["transaction_day"] = df["transactiondate"].dt.day
    df["transaction_weekday"] = df["transactiondate"].dt.weekday

# 2. Revenue after discount
if all(c in df.columns for c in ["price", "discount"]):
    df["revenue"] = df["price"] - df["discount"]

# 3. Total revenue per transaction
if "transactionamount" in df.columns:
    df["total_revenue"] = df["transactionamount"]

# 4. Customer segmentation
if "total_revenue" in df.columns:
    median_revenue = df["total_revenue"].median()
    df["customer_segment"] = df["total_revenue"].apply(lambda x: "high" if x > median_revenue else "low")

print("Features added:")
display(df.head())

# =========================
# Part 6 — Save feature dataset
# =========================
feature_path = os.path.join(DRIVE_BASE, "feature_sales.csv")
df.to_csv(feature_path, index=False)
print(f" Feature CSV saved at: {feature_path}")

# =========================
# Part 7 — Quick summary message
# =========================
print("Notebook 3 complete — Feature engineering done and ready for pgAdmin import (retail.feature_sales).")
